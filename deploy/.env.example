# Mẫu ~/.smashcourt-deploy/.env — file bí mật DUY NHẤT của bản deploy (Epic 6C). File thật KHÔNG commit.
# docker-compose.yml lấy từng khóa ở đây giao cho đúng service cần nó.

# PostgreSQL trên máy (BE và TADSS dùng chung tài khoản, mỗi bên một database)
POSTGRES_USER=smashcourt
POSTGRES_PASSWORD=

# BE: khóa ký JWT, OTP (giá trị ngẫu nhiên riêng của bản deploy, khác máy dev)
JWT_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
OTP_HMAC_SECRET=
# BE: Gmail gửi email (mật khẩu ứng dụng)
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# BE: VNPay sandbox; URL là domain ngrok của BE
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_CALLBACK_URL=
VNPAY_IPN_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# ngrok của BE (tài khoản riêng, domain cố định)
NGROK_AUTHTOKEN=

# BE → TADSS: khóa gốc (BE giữ) và mã băm SHA-256 hex của nó (TADSS giữ). Tạo cặp mới: TADSS-Runtime/tools/security/hash_api_key.py --new
TADSS_API_KEY=
TADSS_API_KEY_SHA256=

# AI
GEMINI_API_KEY=
GEMINI_MODEL=

# seed-db.sh: nguồn dữ liệu là Neon DB TEST tadss-dev (đã áp Phase 6). KHÔNG đặt DB gốc vào đây (script từ chối DB chưa áp Phase 6).
SEED_SOURCE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
SEED_SOURCE_ENDPOINT=ep-royal-hat-a1l7yizx
