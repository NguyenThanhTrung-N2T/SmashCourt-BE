# VNPay Configuration
VNPAY_TMN_CODE=your-tmn-code
VNPAY_HASH_SECRET=your-hash-secret
VNPAY_CALLBACK_URL=https://your-domain.com/booking/payment/result
VNPAY_IPN_URL=https://your-domain.com/api/payments/vnpay/ipn

# Ngrok
NGROK_AUTHTOKEN=your-ngrok-token

# TADSS (BE gọi TADSS): URL công khai ngrok của TADSS và khóa client smashcourt-be (lấy ở TADSS-Runtime/.env TADSS_API_KEY_SMASHCOURT_BE)
TADSS_BASE_URL=https://your-tadss-domain.ngrok-free.dev
TADSS_API_KEY=your-tadss-api-key
