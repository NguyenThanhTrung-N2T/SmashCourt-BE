{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Key": "your-secret-key",
    "Issuer": "your-issuer",
    "Audience": "your-audience",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "ConnectionStrings": {
    "DefaultConnection": "your-connection-string"
  },
  "Otp": {
    "HmacSecret": "your-otp-hmac-secret"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "Username": "your-email",
    "Password": "your-app-password",
    "From": "your-email"
  },
  "Cookie": {
    "Secure": false,
    "RefreshTokenExpirationDays": 7
  },
  "Google": {
    "ClientId": "your-client-id.apps.googleusercontent.com",
    "ClientSecret": "your-client-secret",
    "RedirectUri": "your-redirect-uri"
  },
  "Hangfire": {
    "Enabled": true,
    "Dashboard": false,
    "DashboardPath": "/hangfire"
  },
  "VnPay": {
    "TmnCode": "",
    "HashSecret": "",
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "CallbackUrl": "",
    "IpnUrl": "add-ipn-url-at-here-in-vnpay-setting",
    "Version": "2.1.0",
    "OrderType": "other"
  },
  "FrontendBaseUrl": "https://smashcourt.vn",
  "AIService": {
    "BaseUrl": "http://localhost:8000"
  },
  "TadssConfig": {
    "EnableTadssDecision": false,
    "BaseUrl": "http://localhost:5296",
    "TimeoutMs": 800,
    "ApprovedPaymentWindowMinutes": 15,
    "BranchTimeZone": "Asia/Ho_Chi_Minh"
  },
  "BookingPayment": {
    "InitialHoldMinutes": 10,
    "RetryExtendMinutes": 10,
    "PaymentFailureGraceMinutes": 5,
    "PaymentHoldMaxMinutes": 15,
    "MinOnlinePaymentAmount": 5000
  },
  "RateLimiting": {
    "Login": { "PermitLimit": 5, "WindowSeconds": 60 },
    "Booking": { "PermitLimit": 20, "WindowSeconds": 60 },
    "Sensitive": { "PermitLimit": 10, "WindowSeconds": 60 },
    "AiPublic": { "PermitLimit": 100, "WindowSeconds": 60 },
    "AiUser": { "PermitLimit": 20, "WindowSeconds": 60 },
    "AiManagement": { "PermitLimit": 10, "WindowSeconds": 60 }
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*:/api/ai/*",
        "Period": "1h",
        "Limit": 100
      }
    ],
    "EndpointWhitelist": []
  },
  "IpRateLimitPolicies": {
    "ai-public": {
      "Rules": [
        {
          "Endpoint": "GET:/api/ai/chat/faq",
          "Period": "1m",
          "Limit": 20
        }
      ]
    }
  }
}
