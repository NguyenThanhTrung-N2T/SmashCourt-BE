{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tadss.local/schemas/v2/outcome-request.schema.json",
  "title": "OutcomeRequest v2",
  "description": "Body của POST /api/v2/decisions/{decisionId}/outcome — INTEGRATION_SPEC §3.7; occurredAt bắt buộc có offset.",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "occurredAt"],
  "properties": {
    "outcome": { "enum": ["COMPLETED", "NO_SHOW", "CANCELLED_BY_CUSTOMER", "CANCELLED_BY_STAFF", "PAYMENT_EXPIRED", "APPROVAL_EXPIRED", "REJECTED"] },
    "occurredAt": { "$ref": "#/$defs/dateTime" }
  },
  "$defs": {
    "dateTime": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,7})?(Z|[+-][0-9]{2}:[0-9]{2})$" }
  }
}
