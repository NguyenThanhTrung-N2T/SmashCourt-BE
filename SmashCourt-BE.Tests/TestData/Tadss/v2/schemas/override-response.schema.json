{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tadss.local/schemas/v2/override-response.schema.json",
  "title": "OverrideResponse v2",
  "description": "Response 200 của POST /api/v2/decisions/{decisionId}/override — INTEGRATION_SPEC §3.6; APPROVE ⇔ deposit (đã quy đổi cả rate và amount), REJECT ⇔ deposit null. Mỗi schema v2 tự đủ ($defs nội bộ), nên $defs.deposit là bản sao của decision-detail.schema.json (sửa một bên phải sửa bên kia).",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisionId", "action", "deposit", "actorId", "reason", "overriddenAt"],
  "properties": {
    "decisionId": { "$ref": "#/$defs/uuid" },
    "action": { "enum": ["APPROVE", "REJECT"] },
    "deposit": { "oneOf": [{ "$ref": "#/$defs/deposit" }, { "type": "null" }] },
    "actorId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "reason": { "type": "string", "minLength": 5, "maxLength": 500 },
    "overriddenAt": { "$ref": "#/$defs/dateTime" }
  },
  "if": { "properties": { "action": { "const": "APPROVE" } } },
  "then": { "properties": { "deposit": { "$ref": "#/$defs/deposit" } } },
  "else": { "properties": { "deposit": { "type": "null" } } },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "dateTime": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,7})?(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "deposit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rate", "amount", "currency"],
      "properties": {
        "rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    }
  }
}
