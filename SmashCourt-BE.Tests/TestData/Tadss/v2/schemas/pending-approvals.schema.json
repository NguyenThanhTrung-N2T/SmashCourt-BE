{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tadss.local/schemas/v2/pending-approvals.schema.json",
  "title": "PendingApprovals v2",
  "description": "Response 200 của GET /api/v2/decisions/pending-approvals — INTEGRATION_SPEC §3.5: một trang hàng chờ duyệt (page ≥ 1, pageSize 1..100).",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "page", "pageSize", "totalItems", "totalPages", "hasNext", "hasPrev"],
  "properties": {
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "page": { "type": "integer", "minimum": 1 },
    "pageSize": { "type": "integer", "minimum": 1, "maximum": 100 },
    "totalItems": { "type": "integer", "minimum": 0 },
    "totalPages": { "type": "integer", "minimum": 0 },
    "hasNext": { "type": "boolean" },
    "hasPrev": { "type": "boolean" }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "dateTime": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,7})?(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionId", "reservationId", "branchId", "totalPrice", "currency", "earliestStart", "customer", "reasonCode", "fallbackUsed", "approvalExpiresAt", "createdAt"],
      "properties": {
        "decisionId": { "$ref": "#/$defs/uuid" },
        "reservationId": { "$ref": "#/$defs/uuid" },
        "branchId": { "$ref": "#/$defs/uuid" },
        "totalPrice": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "earliestStart": { "$ref": "#/$defs/dateTime" },
        "customer": { "$ref": "#/$defs/customer" },
        "reasonCode": { "type": "string", "minLength": 1, "maxLength": 64 },
        "fallbackUsed": { "type": "boolean" },
        "approvalExpiresAt": { "$ref": "#/$defs/dateTime" },
        "createdAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isGuest", "tier"],
      "properties": {
        "isGuest": { "type": "boolean" },
        "tier": { "enum": ["STANDARD", "SILVER", "GOLD", "PLATINUM", "DIAMOND"] }
      }
    }
  }
}
